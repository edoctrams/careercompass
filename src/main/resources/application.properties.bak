
spring.application.name=CareerCompass

# Supabase PostgreSQL Connection (using Session Pooler)
# These values are loaded from .env file via run.sh
spring.datasource.url=jdbc:postgresql://${DB_HOST}:5432/postgres?sslmode=require
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.hikari.connection-timeout=10000
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.maximum-pool-size=20

# Hibernate / JPA
# Use 'update' to modify existing schema without deleting data
# Change to 'validate' in production to ensure schema matches
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Spring Security (removed hardcoded credentials - use environment)
